{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../packages ../package.json ../package-lock.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
      "destination": "https://play.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
      "destination": "https://play.pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(play/.*|parent|parent/.*|admin.*|world|vault|who)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
