{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "P=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; git cat-file -e \"$P^{commit}\" 2>/dev/null && git diff --quiet \"$P\" HEAD -- . ../packages ../package.json ../package-lock.json || exit 1",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
      "destination": "https://play.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
      "destination": "https://play.pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "has": [
        {
          "type": "host",
          "value": "parents.pulsarkids.com"
        }
      ],
      "destination": "/parent-login",
      "permanent": true
    },
    {
      "source": "/parent-login",
      "has": [
        {
          "type": "host",
          "value": "play.pulsarkids.com"
        }
      ],
      "destination": "https://parents.pulsarkids.com/parent-login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.pulsarkids.com/api/:path*"
    },
    {
      "source": "/login",
      "has": [
        {
          "type": "host",
          "value": "play.pulsarkids.com"
        }
      ],
      "destination": "/login.html"
    },
    {
      "source": "/parent-login",
      "has": [
        {
          "type": "host",
          "value": "parents.pulsarkids.com"
        }
      ],
      "destination": "/parent-login.html"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(play/.*|parent|parent/.*|admin.*|world|vault|who|try)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    }
  ]
}
