    "title": "Art",
    "games": {
      "mixer": {
        "label": "Color Mixer",
        "blurb": "Mix paints in the cauldron and color the pictures",
        "intro": "The picture is still gray — it needs coloring! Pour paints into the magic cauldron to get the color you need."
      },
      "colors": {
        "label": "Learning colors",
        "blurb": "Find the right color among six",
        "intro": "There are so many colors in the world! Listen to which color to find and tap it. Then tell which color the picture is."
      }
    }
  },
  "introFor": {
    "1": "Now there are white and black paints. White makes a color lighter, and black makes it darker.",
    "2": "The trickiest colors come when you mix a ready-made color with another one. Have a go!",
    "3": "New colors: mint, turquoise, burgundy, lilac… Find out which two paints make them.",
    "4": "Now some colors come only from three paints! Pour three paints into the cauldron, one after another.",
    "5": "Time to sparkle! Add glitter ✨ to the cauldron — and the color turns gold, silver or shiny."
  },
  "prompt": {
    "two": "The {at} must turn {mix}. Which two paints should you mix?",
    "three": "The {at} must turn {mix}. Which three paints should you mix?",
    "shine": "The {at} must turn {mix}. Which two paints should you mix, and what makes it sparkle?"
  },
  "hint": {
    "two": "You get {mix} if you mix {a} and {b} paint.",
