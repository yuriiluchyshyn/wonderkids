{
  "introFor": {
    "1": "Тепер є біла й чорна фарби. Біла робить колір світлішим, а чорна — темнішим.",
    "2": "Найскладніші кольори виходять, коли змішати вже готовий колір з іншим. Спробуй!",
    "3": "Нові кольори: м’ятний, бірюзовий, бордовий, бузковий… Шукай, які дві фарби їх дають.",
    "4": "Тепер деякі кольори виходять лише з трьох фарб! Влий у казан три фарби одну за одною.",
    "5": "Час для блиску! Додай у казан блискітки ✨ — і колір стане золотим, срібним чи блискучим."
  },
  "prompt": {
    "two": "{at}. Які дві фарби треба змішати?",
    "three": "{at}. Які три фарби треба змішати?",
    "shine": "{at}. Які дві фарби змішати й що додати, щоб заблищало?"
  },
  "need": {
    "one": "{thing} має стати {color}",
    "many": "{thing} мають стати {color}"
  },
  "hint": {
    "two": "{name} колір вийде, якщо змішати {paint} і {paint2} фарби.",
    "three": "{name} колір вийде, якщо змішати {paint}, {paint2} і {paint3} фарби.",
    "shine": "{name} колір вийде, якщо змішати {paint} і {paint2} фарби й додати блискітки."
  },
  "outro": {
    "two": "{name} і {b} разом дають {mix}!",
    "three": "{name}, {b} і {c} разом дають {mix}!",
    "shine": "{name} і {b} з блискітками дають {mix}!"
  },
  "colors": {
    "pick": "Вибери {name} колір.",
    "name": "Який це колір?"
