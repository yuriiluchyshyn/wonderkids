  "cards": {
    "title": "Sztuka",
    "games": {
      "mixer": {
        "label": "Mieszanie kolorów",
        "blurb": "Mieszaj farby w kociołku i koloruj obrazki",
        "intro": "Obrazek jest jeszcze szary — trzeba go pokolorować! Wlej do czarodziejskiego kociołka farby, żeby powstał potrzebny kolor."
      },
      "colors": {
        "label": "Poznajemy kolory",
        "blurb": "Znajdź właściwy kolor spośród sześciu",
        "intro": "Ile jest kolorów na świecie! Posłuchaj, jaki kolor trzeba znaleźć, i dotknij go. A potem powiedz, jaki kolor ma obrazek."
      }
    }
  },
  "introFor": {
    "1": "Teraz są też biała i czarna farba. Biała rozjaśnia kolor, a czarna go przyciemnia.",
    "2": "Najtrudniejsze kolory powstają, gdy gotowy kolor zmieszasz z innym. Spróbuj!",
    "3": "Nowe kolory: miętowy, turkusowy, bordowy, liliowy… Sprawdź, z jakich dwóch farb powstają.",
    "4": "Teraz niektóre kolory powstają dopiero z trzech farb! Wlej do kociołka trzy farby, jedną po drugiej.",
    "5": "Czas na blask! Dodaj do kociołka brokat ✨ — a kolor zrobi się złoty, srebrny albo błyszczący."
  },
  "prompt": {
    "two": "Pomaluj {at} {mix}. Jakie dwie farby trzeba zmieszać?",
    "three": "Pomaluj {at} {mix}. Jakie trzy farby trzeba zmieszać?",
    "shine": "Pomaluj {at} {mix}. Jakie dwie farby zmieszać i co dodać, żeby błyszczało?"
  },
  "hint": {
    "two": "Kolor {mix} powstanie, gdy zmieszasz farbę {a} i {b}.",
    "three": "Kolor {mix} powstanie, gdy zmieszasz farbę {a}, {b} i {c}.",
    "shine": "Kolor {mix} powstanie, gdy zmieszasz farbę {a} i {b} i dodasz brokat."
  },
  "outro": {
    "two": "{a} i {b} razem dają {mix}!",
    "three": "{a}, {b} i {c} razem dają {mix}!",
    "shine": "{a} i {b} z brokatem dają {mix}!"
  },
  "colors": {
    "pick": "Wybierz kolor {name}.",
    "name": "Jaki to kolor?"
  }
}
