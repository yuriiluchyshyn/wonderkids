# Copy to .env.local (gitignored) to override during development.

# --- API (server-side only: read by api/* in `npm run dev`, never bundled) ---
# In production these are set in the Vercel project settings.
# Unset → the local Docker database (../docker-compose.yml, port 54329).
# The team setup points .env.local at the production (Neon) database.
# DATABASE_URL=postgres://wonderkids:wonderkids@localhost:54329/wonderkids
# Managed Postgres (Neon etc.): keep sslmode=require. PGSSL=true forces TLS.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# JWT_SECRET=dev-only-change-me
# JWT_EXPIRES_IN=30d

# Admin panel at /admin (accounts, progress, Google Speech per account).
# At least 8 characters (longer is safer); without it the admin API answers 503.
# ADMIN_KEY=change-me-to-a-long-random-string
# Encrypts stored Google API keys. Defaults to JWT_SECRET — if you set it, never
# change it later, or saved keys become unreadable.
# SECRETS_KEY=

# --- Public site / SEO (build time) ---
# The ROOT domain, no trailing slash. Used for canonical links, Open Graph,
# sitemap.xml and the landing page's links to play.<domain> / parents.<domain>.
# VITE_SITE_URL=https://wonderkids.yluch.app
# The root domain shows the landing page and sends app paths to the play. and
# parents. subdomains. If those subdomains are not set up, set this to false:
# the whole app then stays on the root domain and the landing page lives at
# /landing.html.
# VITE_USE_SUBDOMAINS=true

# --- Frontend ---
# Call a deployed API directly instead of the same-origin /api (needs CORS).
# VITE_API_URL=https://wonderkids.yluch.app
