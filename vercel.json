{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wonderkids.yluch.app"
        }
      ],
      "destination": "https://pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
      "destination": "https://play.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wonderkids.yluch.app"
        }
      ],
      "destination": "https://pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.wonderkids.yluch.app"
        }
      ],
