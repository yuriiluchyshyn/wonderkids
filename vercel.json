        {
          "type": "host",
          "value": "parents.wonderkids.yluch.app"
        }
      ],
      "destination": "https://parents.pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "pk_lang",
          "value": "pl"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "play\\..*"
        },
        {
          "type": "host",
          "value": "parents\\..*"
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "pk_lang",
          "value": "en"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "play\\..*"
        },
        {
          "type": "host",
          "value": "parents\\..*"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "PL"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "pk_lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|Slurp|facebookexternalhit|WhatsApp|Lighthouse|[Pp]review|HeadlessChrome).*"
        },
        {
          "type": "host",
          "value": "play\\..*"
        },
        {
          "type": "host",
          "value": "parents\\..*"
        }
      ],
      "destination": "/pl/",
      "permanent": false
