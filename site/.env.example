# Copy to .env.local (gitignored) to override during development.
# In production these are set in the Vercel project of the SITE — every one is
# optional: the defaults are the production addresses.

# The public address of the site: the ROOT domain, no trailing slash. Used for
# canonical links, Open Graph, sitemap.xml and hreflang.
# VITE_SITE_URL=https://pulsarkids.com

# Where the game lives. By default — the play. and parents. subdomains of the
# site's address; set these only when a portal has an address of its own. (On a
# developer's machine the page finds the game's dev server by itself.)
# VITE_PLAY_URL=https://play.pulsarkids.com
# VITE_PARENTS_URL=https://parents.pulsarkids.com
