{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../packages ../package.json ../package-lock.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wonderkids.yluch.app"
        }
      ],
      "destination": "https://pulsarkids.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wonderkids.yluch.app"
        }
      ],
      "destination": "https://pulsarkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "pk_lang",
          "value": "pl"
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "pk_lang",
          "value": "en"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "PL"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "pk_lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|Slurp|facebookexternalhit|meta-external|WhatsApp|Viber|Lighthouse|[Pp]review|HeadlessChrome|Google-InspectionTool|GoogleOther|Google-Read-Aloud|Mediapartners|ChatGPT-User|Claude-User|Perplexity-User|MistralAI-User|cohere-ai|Iframely|Embedly).*"
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "pl.*"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "pk_lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|Slurp|facebookexternalhit|meta-external|WhatsApp|Viber|Lighthouse|[Pp]review|HeadlessChrome|Google-InspectionTool|GoogleOther|Google-Read-Aloud|Mediapartners|ChatGPT-User|Claude-User|Perplexity-User|MistralAI-User|cohere-ai|Iframely|Embedly).*"
        },
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "UA"
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "pk_lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|Slurp|facebookexternalhit|meta-external|WhatsApp|Viber|Lighthouse|[Pp]review|HeadlessChrome|Google-InspectionTool|GoogleOther|Google-Read-Aloud|Mediapartners|ChatGPT-User|Claude-User|Perplexity-User|MistralAI-User|cohere-ai|Iframely|Embedly).*"
        },
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "UA"
        },
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "PL"
        },
        {
          "type": "header",
          "key": "accept-language",
          "value": "uk.*"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/pl",
      "destination": "/pl/",
      "permanent": true
    },
    {
      "source": "/uk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/:path(.*)",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/:lang(en|pl)/privacy",
      "destination": "/:lang/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/:lang(en|pl)/terms",
      "destination": "/:lang/terms/",
      "permanent": true
    },
    {
      "source": "/landing.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://play.pulsarkids.com/login",
      "permanent": false
    },
    {
      "source": "/try",
      "destination": "https://play.pulsarkids.com/try",
      "permanent": false
    },
    {
      "source": "/play/:path*",
      "destination": "https://play.pulsarkids.com/play/:path*",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "https://play.pulsarkids.com/world",
      "permanent": false
    },
    {
      "source": "/vault",
      "destination": "https://play.pulsarkids.com/vault",
      "permanent": false
    },
    {
      "source": "/who",
      "destination": "https://play.pulsarkids.com/who",
      "permanent": false
    },
    {
      "source": "/parent",
      "destination": "https://parents.pulsarkids.com/parent",
      "permanent": false
    },
    {
      "source": "/parent/:path*",
      "destination": "https://parents.pulsarkids.com/parent/:path*",
      "permanent": false
    },
    {
      "source": "/parent-login",
      "destination": "https://parents.pulsarkids.com/parent-login",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://parents.pulsarkids.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://parents.pulsarkids.com/admin/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/(llms|llms-full).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/en/",
      "headers": [
        {
          "key": "Link",
          "value": "</en/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/pl/",
      "headers": [
        {
          "key": "Link",
          "value": "</pl/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    }
  ]
}
