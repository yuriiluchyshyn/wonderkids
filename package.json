{
  "name": "pulsar-kids",
  "private": true,
  "version": "0.1.0",
  "description": "Pulsar Kids — the public site and the game, deployed apart, with what they share in packages/",
  "workspaces": [
    "site",
    "game",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:site": "npm run dev -w @pulsar/site",
    "dev:game": "npm run dev -w @pulsar/game",
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build -w @pulsar/site",
    "build:game": "npm run build -w @pulsar/game",
    "test": "npm test --workspaces --if-present",
    "check:content": "npm run check:content -w @pulsar/game"
  }
}
